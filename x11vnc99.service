[Unit]
Description=x11vnc :99 na portu 5900 (Box A — VNC náhled trackeru)
After=xvfb99.service
Wants=xvfb99.service

[Service]
Type=simple
User=pi
Group=pi
WorkingDirectory=/home/pi
ExecStart=/usr/bin/x11vnc -display :99 -forever -shared -rfbport 5900 \
    -rfbauth /home/pi/.vnc/passwd -o /tmp/x11vnc99.log -quiet
Restart=always
RestartSec=2
StandardOutput=journal
StandardError=journal
SyslogIdentifier=x11vnc99

[Install]
WantedBy=multi-user.target
