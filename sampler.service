[Unit]
Description=Tracker Box Sampler (433 MHz RF button trigger)
After=sound.target
Wants=sound.target

[Service]
Type=simple
WorkingDirectory=/home/pi/tracker
# --allow-restart: bez něj sampler ignoruje akční sloty @restart v mapě
# a tlačítko F hlásí "not in map". Služba běží jako root, aby systemctl
# restart fungoval. Pokud se někdy mapu edituje ručně, je to ekvivalent
# úrovni přístupu k root — mapa je důvěryhodný vstup, ne data z boxu.
ExecStart=/usr/local/bin/sampler --box b --allow-restart
Restart=always
RestartSec=2
# 433 MHz readout do journalu: každý stisk tlačítka jako
# "code=12200123 -> sample_b_01.wav (S01, #7)"
SyslogIdentifier=sampler
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target