[Unit]
Description=Tracker Box A (headless: camera tracking + audio)
After=sound.target
Wants=sound.target
# Webkamera se po bootu objeví až za pár sekund. Bez vypnutého limitu by 5 rychlých
# restartů (RestartSec=2) překročilo systemd limit 5 startů/10 s, služba by skončila
# ve stavu failed a tracker by zůstal tichý až do ručního zásahu.
StartLimitIntervalSec=0

[Service]
Type=simple
User=pi
Group=pi
WorkingDirectory=/home/pi/tracker
# --max-people 4: hrací plocha je malá a víc CSRT/KCF trackerů by Pi 4
# zpomalilo. Tlačítko F (RF na GPIO15) restartuje službu; Restart=always
# plus StartLimitIntervalSec=0 to zvedne po čistém i divokém exit.
ExecStart=/home/pi/tracker/tracker --headless --max-people 4 --tracker kcf
Restart=always
RestartSec=2
KillSignal=SIGTERM
TimeoutStopSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=tracker

[Install]
WantedBy=multi-user.target
