[Unit]
Description=Tracker Box A (headless: camera tracking + audio)
After=sound.target
Wants=sound.target
# Kameru a zvukovku smí držet jen jeden tracker, proto se bezhlavá a okenní
# (VNC) služba vzájemně vylučují.
Conflicts=tracker-vnc.service
# Tracker + sampler sloučené do jednoho procesu: 8 smyček (4 nálady + 3
# intermezza + podklad track9) hraje jen když je zapnutá interaction,
# RF tlačítka (GPIO15) přes map.csv pouští vzorky navrch (one-shot vrstvy),
# F = @interact umlčí vrstvy a přepne interaction (on/off, ticho). Kamera je
# volitelná — bez ní proces jede dál (zvuk + tlačítka) a kameru zkouší
# otevírat každé 2 s.
StartLimitIntervalSec=0

[Service]
Type=simple
# root kvůli @restart akcím z map.csv (systemctl restart); User=pi by je
# pouštěl naprázdno. @stopall/@interact root nepotřebují, ale nic nerozbijí.
User=root
Group=root
WorkingDirectory=/home/pi/tracker
# Smyčky nahrané a spuštěné naráz; dokud je interaction vypnutá, jsou
# ztlumené (ticho). Zelená koule míchá nálady, červená intermezza,
# podklad track9 hraje konstantně, RF vzorky hrají navrch.
ExecStart=/home/pi/tracker/tracker --headless --allow-restart --map map.csv
Restart=always
RestartSec=2
KillSignal=SIGTERM
TimeoutStopSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=tracker

[Install]
WantedBy=multi-user.target
