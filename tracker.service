[Unit]
Description=Tracker Box A (headless: camera tracking + audio)
After=sound.target
Wants=sound.target
# Webkamera se po bootu objeví až za pár sekund. Bez vypnutého limitu by 5 rychlých
# restartů (RestartSec=2) překročilo systemd limit 5 startů/10 s, služba by skončila
# ve stavu failed a tracker by zůstal tichý až do ručního zásahu.
StartLimitIntervalSec=0

[Service]
Type=simple
User=pi
Group=pi
WorkingDirectory=/home/pi/tracker
# --max-people 1: výchozí limit hlídače na jednoho člověka (main.c).
# --no-rf: na boxu A běží vedle trackeru i sampler a ten vlastní RF link na
# GPIO15 (tlačítko F = @stopall v map.csv). RF trackeru jde zapnout přes
# --rf-pin N, když sampler neběží.
ExecStart=/home/pi/tracker/tracker --headless --max-people 1 --tracker kcf --no-rf
Restart=always
RestartSec=2
KillSignal=SIGTERM
TimeoutStopSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=tracker

[Install]
WantedBy=multi-user.target
