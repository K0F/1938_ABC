// HW §1 — Architektura a role boxů (2-box topology)
digraph G {
    graph [fontname="DejaVu Sans" rankdir=TB bgcolor="white" nodesep=0.7 ranksep=0.9];
node [fontname="DejaVu Sans" fontsize=12 style="filled"];
edge [fontname="DejaVu Sans" fontsize=10];

// Tlačítka
tlačítka [label="10× hotové tlačítko\nSolight 1L67T\nvšechna pro B" shape=octagon style="filled" fillcolor="#ffccbc" width=2.2];

// Boxes
boxB [label="BOX B\n─────────\nPi 4 8 GB\nSRX882S\nLCD 16×2 (volitelný)\nrepro + amp\nUSB zvukovka\njack 3,5\nPSU 15,3 W" shape=box style="filled,rounded" fillcolor="#c8e6c9" width=2];
boxA [label="BOX A\n─────────\nPi 4 8 GB\n+ webkamera (tracker)\nUSB zvukovka\njack 3,5 na panelu\nPSU 15,3 W" shape=box style="filled,rounded" fillcolor="#bbdefb" width=2.2];

// Power — každý box samostatně do zásuvky 230 V
rozvod [label="230 V zásuvka\n/ odbočka na kabelu" shape=oval fillcolor="#fff9c4"];

// RF
tlačítka -> boxB [label="  RF 433 MHz (ASK)  " color="#ff6f00" penwidth=1.5 style=bold];

// Power (each box plugs into 230 V separately, converts with its own 15,3 W PSU)
rozvod -> boxA [label="  230 V\n  5 m šňůra  " color="#d32f2f" penwidth=1.2];
rozvod -> boxB [label="  230 V\n  5 m šňůra  " color="#d32f2f" penwidth=1.0];

// Note
note [label="Synchronizace sampleru:\nWiFi 2,4 GHz (rsync z A)\n\nNapájení: každý box\nvlastní zdroj 15,3 W\n(5 V se nerozvádí)" shape=note fillcolor="#f5f5f5" fontsize=10];
boxA -> note [style=dotted color="#666666"];
}
