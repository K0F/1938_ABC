// SCH §6 — Napájení — jeden jednotný rozvod
digraph G {
    graph [fontname="DejaVu Sans" rankdir=LR bgcolor="white" nodesep=0.8 ranksep=1.0];
node [fontname="DejaVu Sans" fontsize=12 style="filled"];
edge [fontname="DejaVu Sans" fontsize=10];

// Boxes
boxA [label="BOX A\n─────────\nSvorkovnice\n230 V\n+ zdroj 15,3 W" shape=box style="filled,rounded" fillcolor="#bbdefb" width=1.8];
boxB [label="BOX B\n─────────\nVlastní PSU\n15,3 W (Pi 4)" shape=box style="filled,rounded" fillcolor="#c8e6c9" width=1.8];
boxC [label="BOX C\n─────────\nSvorkovnice\n(z A)\n+ zdroj 15,3 W" shape=box style="filled,rounded" fillcolor="#c8e6c9" width=1.8];

// Cables
boxA -> boxB [label="  2 m šňůra\n  JT003  " color="#d32f2f" penwidth=1.5];
boxA -> boxC [label="  2 m šňůra\n  JT003  " color="#d32f2f" penwidth=1.5 dir=back];

// Notes
note [label="Žádný rozvod 5 V mezi boxy —\nPi 4 má vždy svůj zdroj.\nV boxu A: jištění 230 V ≤10 A." shape=note fillcolor="#f5f5f5" fontsize=10];
boxA -> note [style=dotted color="#666666"];
}
