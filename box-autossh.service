[Unit]
Description=Box Reverse autossh tunnel to pesek.com (central server)
After=network-online.target NetworkManager.service
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
Environment=AUTOSSH_GATETIME=0
ExecStart=/usr/local/sbin/box-autossh.sh run
Restart=always
RestartSec=5
User=pi
Group=pi

[Install]
WantedBy=multi-user.target
